<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="Controllers.SessionHistoryController"
      spacing="20"
      prefWidth="1000"
      prefHeight="650"
      style="-fx-background-color:  linear-gradient(to bottom, #e8c092, #f0e7ad); -fx-padding: 30;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="20"
          style="-fx-background-color: rgba(212, 163, 115, 0.3); -fx-background-radius: 15; -fx-padding: 15;">
        <Label text="Game History" textFill="#3e2723">
            <font>
                <Font name="System Bold" size="28"/>
            </font>
        </Label>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="← Back to Menu" onAction="#backToMenu"
                styleClass="button"
                style="-fx-font-size: 16px; -fx-padding: 12 25;"/>
    </HBox>

    <TableView fx:id="historyTable"
               style="-fx-background-color: rgba(250, 237, 205, 0.9);
                      -fx-background-radius: 15;
                      -fx-border-color: #3e2723;
                      -fx-border-width: 2px;
                      -fx-border-radius: 15;
                      -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 8, 0, 0, 3);">

        <columns>
            <TableColumn fx:id="player1Column" text="Player 1" prefWidth="150"
                         style="-fx-alignment:  CENTER; -fx-font-weight: bold; -fx-font-size: 14px;"/>

            <TableColumn fx:id="player2Column" text="Player 2" prefWidth="150"
                         style="-fx-alignment: CENTER; -fx-font-weight: bold; -fx-font-size: 14px;"/>

            <TableColumn fx:id="winnerColumn" text=" Winner" prefWidth="150"
                         style="-fx-alignment: CENTER; -fx-font-weight: bold; -fx-font-size: 14px;"/>

            <TableColumn fx:id="durationColumn" text="Duration" prefWidth="100"
                         style="-fx-alignment:  CENTER; -fx-font-size: 13px;"/>

            <TableColumn fx:id="typeColumn" text="Type" prefWidth="120"
                         style="-fx-alignment:  CENTER; -fx-font-size: 13px;"/>

            <TableColumn fx:id="dateColumn" text="Date &amp; Time" prefWidth="200"
                         style="-fx-alignment: CENTER; -fx-font-size: 13px;"/>
        </columns>

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

</VBox>