<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="750.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.MenuController">
   <children>
      <Button fx:id="startLocalButton" alignment="CENTER" contentDisplay="CENTER" layoutX="280.0" layoutY="286.0" mnemonicParsing="false" onAction="#startLocalSession" prefHeight="40.0" prefWidth="190.0" text="Start Local Game" textFill="#813f1e">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Button>
      <Button fx:id="startOnlineButton" alignment="CENTER" contentDisplay="CENTER" layoutX="280.0" layoutY="391.0" mnemonicParsing="false" onAction="#startOnlineSession" prefHeight="40.0" prefWidth="190.0" text="Start Online Game" textFill="#813f1e">
         <font>
            <Font size="16.0" />
         </font>
      </Button>
      <Button fx:id="howToPlayButton" alignment="CENTER" contentDisplay="CENTER" layoutX="280.0" layoutY="495.0" mnemonicParsing="false" onAction="#howToPlay" prefHeight="40.0" prefWidth="190.0" text="How To Play" textFill="#813f1e">
         <font>
            <Font size="16.0" />
         </font>
      </Button>
      <ImageView fitHeight="212.0" fitWidth="298.0" layoutX="245.0" layoutY="39.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@GameLogo.png" />
         </image>
      </ImageView>
      <Button fx:id="viewHistoryButton" alignment="CENTER" contentDisplay="CENTER" layoutX="280.0" layoutY="574.0" mnemonicParsing="false" onAction="#viewHistory" prefHeight="40.0" prefWidth="190.0" text="Session history" textFill="#813f1e">
         <font>
            <Font size="16.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
